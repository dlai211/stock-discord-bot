venv/
.env
__pycache__/
*.pyc

# Runtime state written by the macro alert poller
state/
*.log

# Private keys and certificates. Cloud providers (Oracle, AWS) hand these out as
# .key/.pem files and they often land in whatever folder you were in at the
# time — never let one reach the repo.
*.key
*.pem
id_rsa*
id_ed25519*
