# Template for the .env file. Copy this file to `.env` and fill in real values.
# `.env` is listed in .gitignore — never commit it, and never paste its contents anywhere.
# On Windows:  copy .env.example .env

# Discord bot token.
# Discord Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_TOKEN=

# Finnhub API key, used for the weekly earnings calendar.
# Free tier is enough: https://finnhub.io/register
FINNHUB_KEY=

# Channel where scheduled briefings and macro alerts are posted.
# In Discord, enable Settings -> Advanced -> Developer Mode, then
# right-click the target channel and choose "Copy Channel ID".
TARGET_CHANNEL_ID=

# FRED (Federal Reserve Economic Data) API key.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
